{
  "mcpServers" : {
    "impulse" : {
      "args" : [
        "-c",
        "exec \"${IMPULSE_CLI:-/Users/a b/Impulse \\\"x\\\"/\\$y\\`/impulse}\" mcp"
      ],
      "command" : "sh",
      "env" : {
        "IMPULSE_CLI" : "${IMPULSE_CLI:-}",
        "IMPULSE_PANE_TOKEN" : "${IMPULSE_PANE_TOKEN:-}",
        "IMPULSE_SOCKET" : "${IMPULSE_SOCKET:-}"
      },
      "type" : "stdio"
    }
  }
}