module Clibgit2 {
    // Vendored static libgit2 built by scripts/build-libgit2.sh.
    // git2.h resolves its own subheaders via quoted relative includes,
    // so no extra header search path is required.
    header "../.libgit2/1.9.1/include/git2.h"
    link "git2"
    link "z"
    link "iconv"
    export *
}
